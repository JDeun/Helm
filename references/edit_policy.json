{
  "default": "patch_first",
  "max_patch_failures_per_file": 2,
  "on_repeated_patch_failure": "reload_context_then_decompose",
  "requires_checkpoint_for": ["shared_workflow", "skill_router", "automation"],
  "read_before_write": {
    "mode": "required",
    "stale_read_requires_reload": true
  },
  "whole_file_rewrite_allowed_for": [
    "new_file",
    "generated_artifact",
    "small_file",
    "explicit_user_request"
  ]
}
