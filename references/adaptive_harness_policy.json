{
  "model_aliases": {
    "codex": "frontier",
    "gpt-5": "frontier",
    "gpt-5.4": "frontier",
    "gemini": "enhanced",
    "gemini-api": "enhanced",
    "gemini-2.5-pro": "enhanced",
    "gemma": "constrained",
    "gemma4": "constrained",
    "gemma4:e4b": "constrained",
    "gemma-local": "constrained"
  },
  "enforcement_order": ["light", "balanced", "strict"],
  "tiers": {
    "frontier": {
      "default_enforcement": "light",
      "profile_overrides": {
        "risky_edit": "balanced",
        "service_ops": "balanced",
        "remote_handoff": "balanced"
      }
    },
    "enhanced": {
      "default_enforcement": "balanced",
      "profile_overrides": {
        "remote_handoff": "strict"
      }
    },
    "constrained": {
      "default_enforcement": "balanced",
      "profile_overrides": {
        "risky_edit": "strict",
        "service_ops": "strict",
        "remote_handoff": "strict"
      }
    }
  },
  "validation": {
    "context_required_at_or_above": "balanced",
    "task_name_required_profiles": ["service_ops", "risky_edit", "remote_handoff"],
    "runtime_target_required_profiles": ["remote_handoff"],
    "finalization_must_not_be_pending_at_or_above": "balanced",
    "skill_relevance_min_score": 25,
    "skill_relevance_block_verdicts": ["poor"],
    "skill_relevance_warn_verdicts": ["weak"]
  },
  "completion_policy": {
    "enabled": true,
    "default_enforce_at_or_above": "balanced",
    "profiles": {
      "workspace_edit": {
        "require_one_of": ["file_diff", "diagnostics", "direct_inspection", "write_validation", "completion_evidence"]
      },
      "risky_edit": {
        "require_all": ["checkpoint_id"],
        "require_one_of": ["test_or_lint_or_diff", "write_validation", "completion_evidence"]
      },
      "service_ops": {
        "require_one_of": ["process_exit", "healthcheck", "provider_result", "completion_evidence"]
      },
      "remote_handoff": {
        "require_one_of": ["handoff_target", "completion_evidence"]
      }
    }
  }
}
